---
import BlogPost from "../../layouts/BlogPost.astro";
import article from "../../data/goai/goai-how-the-google-algorithm-works-in-2025.json";
const title = "How the Google algorithm works in 2025";
const description = "How the Google algorithm works in 2025 : there is no single algorithm, but three stages (crawling, indexing, ranking) and dozens of systems working together on ranking, some publicly...";
const date = "2025-07-01";
---

<BlogPost title={title} description={description} date={date} category="SEO" readTime="7 min read" image={article.image} sourceAuthor={article.sourceAuthor} sourceUrl={article.sourceUrl} sourceUpdatedAt={article.sourceUpdatedAt}>
  <div class="goai-content" set:html={article.body} />
</BlogPost>
