---
import BlogPost from "../../layouts/BlogPost.astro";
import article from "../../data/goai/goai-march-2026-spam-update-which-sites-were-affected-and-how-to-protect-yourself.json";
const title = "March 2026 spam update: which sites were affected and how to protect yourself";
const description = "March 2026 spam update: which sites were affected and how to protect yourself : Google announced the update on 24 March 2026, at 12:18 Pacific time, through the status page and LinkedIn,...";
const date = "2026-04-25";
---

<BlogPost title={title} description={description} date={date} category="SEO" readTime="7 min read" image={article.image} sourceAuthor={article.sourceAuthor} sourceUrl={article.sourceUrl} sourceUpdatedAt={article.sourceUpdatedAt}>
  <div class="goai-content" set:html={article.body} />
</BlogPost>
