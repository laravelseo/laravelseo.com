---
export const prerender = true;

import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Card from "../../components/ui/Card.astro";

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection("blog");
  const sortedPosts = allPosts.sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime() ||
      a.slug.localeCompare(b.slug)
  );
  return paginate(sortedPosts, { pageSize: 12 });
}

const { page } = Astro.props;

function getPageNumbers(current: number, last: number): (number | "...")[] {
  if (last <= 7) return Array.from({ length: last }, (_, i) => i + 1);
  const pages: (number | "...")[] = [1];
  const rangeStart = Math.max(2, current - 1);
  const rangeEnd = Math.min(last - 1, current + 1);
  if (rangeStart > 2) pages.push("...");
  for (let i = rangeStart; i <= rangeEnd; i++) pages.push(i);
  if (rangeEnd < last - 1) pages.push("...");
  pages.push(last);
  return pages;
}

const pageNumbers = getPageNumbers(page.currentPage, page.lastPage);

function tagSlug(tag: string): string {
  return tag.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}

function readingTime(body: string): number {
  const words = (body || "")
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/[#*`\[\]()>-]/g, " ")
    .split(/\s+/)
    .filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}

const allPosts = await getCollection("blog");
const tagCounts = new Map<string, number>();
for (const p of allPosts) {
  for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
}
const tags = [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const pageTitle =
  page.currentPage === 1
    ? "Laravel SEO Blog - Tips, Guides & Best Practices"
    : `Laravel SEO Blog - Page ${page.currentPage}`;
const pageDescription =
  page.currentPage === 1
    ? "Expert articles about Laravel SEO optimization, meta tags, structured data, and technical SEO best practices for Laravel developers."
    : `Laravel SEO articles, page ${page.currentPage} of ${page.lastPage}.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <BreadcrumbSchema items={[
    { name: "Home", href: "/" },
    { name: "Blog", href: "/blog" },
  ]} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Laravel SEO Blog",
    "description": "Expert articles about Laravel SEO optimization, meta tags, structured data and technical SEO best practices.",
    "url": "https://laravelseo.com/blog",
  })} />
  {page.url.prev && (
    <link rel="prev" href={new URL(page.url.prev, "https://laravelseo.com").href} />
  )}
  {page.url.next && (
    <link rel="next" href={new URL(page.url.next, "https://laravelseo.com").href} />
  )}

  <section class="relative py-24 overflow-hidden bg-slate-900">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Laravel SEO Blog</h1>
        <p class="text-xl text-slate-300">Expert guides, tips, and best practices for optimizing your Laravel applications for search engines.</p>
      </div>
    </div>
  </section>

  <section class="bg-slate-950 py-16 lg:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      {page.currentPage === 1 && (
        <form action="/search/" method="get" role="search" class="max-w-md mx-auto mb-10">
          <label for="blog-search" class="sr-only">Search the blog</label>
          <div class="flex gap-2">
            <input
              id="blog-search"
              type="search"
              name="q"
              placeholder="Search the blog..."
              class="flex-1 min-h-11 px-4 rounded-lg bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:border-violet-500 focus:outline-none transition-colors"
            />
            <button type="submit" class="min-h-11 px-5 rounded-lg bg-violet-600 text-white text-sm font-semibold hover:bg-violet-500 transition-colors">Search</button>
          </div>
        </form>
      )}

      {page.currentPage === 1 && (
        <nav class="flex flex-wrap justify-center gap-2 mb-12 max-w-5xl mx-auto" aria-label="Browse posts by tag">
          {tags.map(([t, count]) => (
            <a
              href={`/blog/tag/${tagSlug(t)}/`}
              class="inline-flex items-center min-h-11 px-4 rounded-full bg-slate-900 border border-slate-700 text-sm text-slate-300 hover:text-white hover:border-violet-500/50 transition-all"
            >
              {t} ({count})
            </a>
          ))}
          <a
            href="/rss.xml"
            class="inline-flex items-center min-h-11 px-4 rounded-full bg-slate-900 border border-slate-700 text-sm text-slate-300 hover:text-white hover:border-violet-500/50 transition-all"
          >
            RSS feed
          </a>
        </nav>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {page.data.map((post) => (
          <a href={`/blog/${post.slug}/`} class="group block">
            <Card hover class="h-full p-6 transition-all group-hover:border-violet-500/50">
              <div class="flex items-center gap-3 mb-4">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="rounded-full bg-violet-500/10 px-3 py-1 text-xs font-medium text-violet-400">{tag}</span>
                ))}
                <span class="text-xs text-slate-500">{readingTime(post.body ?? "")} min read</span>
              </div>
              <h2 class="mb-3 text-xl font-bold text-white group-hover:text-violet-400 transition-colors">{post.data.title}</h2>
              <p class="mb-4 text-sm text-slate-400 leading-relaxed line-clamp-3">{post.data.description}</p>
              <div class="flex items-center justify-between text-sm">
                <span class="text-slate-500">{new Date(post.data.pubDate).toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}</span>
                <span class="flex items-center gap-1 text-violet-400 font-medium text-sm">
                  Read More
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </Card>
          </a>
        ))}
      </div>

      {page.lastPage > 1 && (
        <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
          {page.url.prev && (
            <a
              href={page.url.prev}
              class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-800"
            >
              Previous
            </a>
          )}

          <div class="flex items-center gap-1">
            {pageNumbers.map((num) =>
              num === "..." ? (
                <span class="px-2 text-slate-500">…</span>
              ) : (
                <a
                  href={num === 1 ? "/blog/" : `/blog/${num}/`}
                  class={`min-w-[40px] rounded-lg px-3 py-2 text-sm font-medium text-center transition-colors ${num === page.currentPage ? "bg-violet-600 text-white" : "border border-slate-700 bg-slate-900 text-slate-300 hover:bg-slate-800"}`}
                  aria-current={num === page.currentPage ? "page" : undefined}
                >
                  {num}
                </a>
              )
            )}
          </div>

          {page.url.next && (
            <a
              href={page.url.next}
              class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-800"
            >
              Next
            </a>
          )}
        </nav>
      )}

      <p class="text-center text-sm text-slate-500 mt-10">
        Looking for something older? <a href="/blog/archive/" class="text-violet-400 hover:text-violet-300 transition-colors">Browse the full archive</a>
      </p>
    </div>
  </section>
</BaseLayout>
