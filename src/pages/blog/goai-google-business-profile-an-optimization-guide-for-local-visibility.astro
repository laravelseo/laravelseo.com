import article from "../../data/goai/goai-google-business-profile-an-optimization-guide-for-local-visibility.json";
const title = "Google Business Profile: An optimization guide for local visibility";
const description = "The visibility of a local business in Google results depends largely on the quality and completeness of its Google Business profile. This free tool from Google allows any business to appear...";
