---
import BlogPost from "../../layouts/BlogPost.astro";
import article from "../../data/goai/goai-what-is-seo-and-how-to-get-organic-traffic.json";
const title = "What is SEO and how to get organic traffic";
const description = "What is SEO! A highly searched expression in search engines. In this article you will learn exactly how to reach the first position in Google, even if you are a beginner with no SEO...";
const date = "2025-12-28";
---

<BlogPost title={title} description={description} date={date} category="SEO" readTime="7 min read" image={article.image} sourceAuthor={article.sourceAuthor} sourceUrl={article.sourceUrl} sourceUpdatedAt={article.sourceUpdatedAt}>
  <div class="goai-content" set:html={article.body} />
</BlogPost>
