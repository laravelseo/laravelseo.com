---
import BlogPost from "../../layouts/BlogPost.astro";
import article from "../../data/goai/goai-complete-guide-to-google-search-console.json";
const title = "Complete guide to Google Search Console";
const description = "Complete guide to Google Search Console , the free tool through which Google tells you how it sees your website: which searches display it, which pages are indexed and why others are not,...";
const date = "2025-07-24";
---

<BlogPost title={title} description={description} date={date} category="SEO" readTime="7 min read" image={article.image} sourceAuthor={article.sourceAuthor} sourceUrl={article.sourceUrl} sourceUpdatedAt={article.sourceUpdatedAt}>
  <div class="goai-content" set:html={article.body} />
</BlogPost>
