---
import BlogPost from "../../layouts/BlogPost.astro";
import article from "../../data/goai/goai-website-optimization.json";
const title = "Website optimization";
const description = "Website optimization: how to turn your website into a tool that brings in customers. A website that isn't optimized is like a physical store with the door locked. It exists, takes up space,...";
const date = "2026-03-06";
---

<BlogPost title={title} description={description} date={date} category="SEO" readTime="7 min read" image={article.image} sourceAuthor={article.sourceAuthor} sourceUrl={article.sourceUrl} sourceUpdatedAt={article.sourceUpdatedAt}>
  <div class="goai-content" set:html={article.body} />
</BlogPost>
