---
import BlogPost from "../../layouts/BlogPost.astro";
import article from "../../data/goai/goai-google-pagespeed-insights-how-to-interpret-and-improve-your-score.json";
const title = "Google PageSpeed Insights: How to interpret and improve your score";
const description = "A website's loading speed directly influences its ranking in search engines, its conversion rate and user satisfaction. Every extra second it takes for the page to display can mean losing a...";
const date = "2026-03-15";
---

<BlogPost title={title} description={description} date={date} category="SEO" readTime="8 min read" image={article.image} sourceAuthor={article.sourceAuthor} sourceUrl={article.sourceUrl} sourceUpdatedAt={article.sourceUpdatedAt}>
  <div class="goai-content" set:html={article.body} />
</BlogPost>
