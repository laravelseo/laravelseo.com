---
import BlogPost from "../../layouts/BlogPost.astro";
import article from "../../data/goai/goai-url-structure-and-its-impact-on-search-engine-rankings.json";
const title = "URL structure and its impact on search engine rankings";
const description = "The URL structure of a website influences how search engines understand, index and rank its pages. A clear, descriptive and consistent URL gives both users and Google relevant information...";
const date = "2026-03-24";
---

<BlogPost title={title} description={description} date={date} category="SEO" readTime="8 min read" image={article.image} sourceAuthor={article.sourceAuthor} sourceUrl={article.sourceUrl} sourceUpdatedAt={article.sourceUpdatedAt}>
  <div class="goai-content" set:html={article.body} />
</BlogPost>
