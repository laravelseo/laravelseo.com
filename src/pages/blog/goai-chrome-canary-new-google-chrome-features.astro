---
import BlogPost from "../../layouts/BlogPost.astro";
import article from "../../data/goai/goai-chrome-canary-new-google-chrome-features.json";
const title = "Chrome Canary, New Google Chrome Features";
const description = "Chrome Canary, new Google Chrome features that change how you use the browser Currently, Google Chrome is no longer just a browser for basic internet browsing. Recent updates introduce...";
const date = "2026-01-04";
