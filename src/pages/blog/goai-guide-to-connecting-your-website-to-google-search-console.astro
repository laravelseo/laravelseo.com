---
import BlogPost from "../../layouts/BlogPost.astro";
import article from "../../data/goai/goai-guide-to-connecting-your-website-to-google-search-console.json";
const title = "Guide to connecting your website to Google Search Console";
const description = "Guide to connecting your website to Google Search Console , the free tool through which Google tells you how it sees your website: which pages are indexed, which searches they appear for,...";
const date = "2025-07-02";
---

<BlogPost title={title} description={description} date={date} category="SEO" readTime="7 min read" image={article.image} sourceAuthor={article.sourceAuthor} sourceUrl={article.sourceUrl} sourceUpdatedAt={article.sourceUpdatedAt}>
  <div class="goai-content" set:html={article.body} />
</BlogPost>
