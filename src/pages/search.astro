---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search" description="Search the site and blog." robots="noindex, follow">
  <section style="padding:160px 24px 80px;min-height:65vh;text-align:center;color:#f1f5f9">
    <h1 style="font-size:32px;font-weight:700;margin-bottom:20px">Search</h1>
    <p>Search articles and guides using the search button in the header.</p>
    <button id="open-site-search" type="button" style="margin-top:24px;padding:12px 24px;border:1px solid #a78bfa;border-radius:8px;background:#7c3aed;color:white">Open search</button>
  </section>
</BaseLayout>
<script>
  function openSearch() {
    const trigger = document.querySelector<HTMLButtonElement>('.DocSearch-Button');
    if (!trigger) return false;
    trigger.click();
    return true;
  }
  document.querySelector('#open-site-search')?.addEventListener('click', openSearch);
  const query = new URLSearchParams(location.search).get('q');
  if (query) {
    let attempts = 0;
    const timer = setInterval(() => {
      if (!document.querySelector('.DocSearch-Input')) openSearch();
      const input = document.querySelector<HTMLInputElement>('.DocSearch-Input');
      if (input) {
        const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set;
        setter?.call(input, query);
        input.dispatchEvent(new Event('input', { bubbles: true }));
        clearInterval(timer);
      }
      if (++attempts > 100) clearInterval(timer);
    }, 100);
  }
</script>
