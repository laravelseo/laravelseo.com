---
const shots = [
  {
    src: "/images/app/report-detail.png",
    alt: "SEO audit report for drupalcompany.com scoring 91 out of 100, with issue breakdown and page stats",
    title: "Audit reports with a clear score",
    desc: "Every audit ends in a 0-100 score with issues grouped by severity, plus load time, page weight and resource count.",
  },
  {
    src: "/images/app/dashboard.png",
    alt: "Laravel SEO dashboard with report quality overview and latest reports",
    title: "A dashboard that tracks quality over time",
    desc: "See the split of good, decent and bad reports across all your projects at a glance.",
  },
  {
    src: "/images/app/sites.png",
    alt: "Sites monitor checking 997 sites with alive and dead statuses",
    title: "Site health monitoring at scale",
    desc: "Bulk-check whole site lists for liveness, status codes and platform, and export the alive ones as CSV.",
  },
];
---

<section class="bg-slate-800 border-t border-slate-700 py-20" aria-labelledby="screenshots-heading">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 bg-violet-600 text-white text-sm font-semibold rounded-full mb-4">
        Real product, real screenshots
      </div>
      <h2 id="screenshots-heading" class="text-3xl md:text-4xl font-bold text-white mb-4">
        See Laravel SEO at work
      </h2>
      <p class="text-slate-300 text-lg max-w-2xl mx-auto">
        Captured from the live app at
        <a href="https://app.laravelseo.com" target="_blank" rel="noopener noreferrer" class="text-violet-400 hover:text-violet-300">app.laravelseo.com</a>.
        No mockups.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
      {shots.map((shot) => (
        <figure class="p-4 bg-slate-900/50 rounded-xl border border-slate-700/50 hover:border-violet-500/50 transition-all h-full flex flex-col">
          <img
            src={shot.src}
            alt={shot.alt}
            width="1280"
            height="720"
            loading="lazy"
            class="rounded-lg border border-slate-700 w-full h-auto"
          />
          <figcaption class="pt-4">
            <h3 class="text-white font-bold mb-1">{shot.title}</h3>
            <p class="text-slate-400 text-sm">{shot.desc}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href="/tutorials"
        class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-violet-600 to-pink-500 hover:from-violet-500 hover:to-pink-400 rounded-lg transition-all shadow-lg shadow-violet-500/25"
      >
        Read the tutorials
      </a>
    </div>
  </div>
</section>
