---
import { TOOL_CATEGORIES, TOOL_COUNT, APP_TOOLS_BASE } from "../../data/tools";
---

<section class="bg-slate-900 py-16 md:py-24" aria-labelledby="tools-heading">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 id="tools-heading" class="text-2xl md:text-3xl font-bold text-white mb-4">SEO Tools & Utilities</h2>
      <p class="text-slate-300 text-lg">
        {TOOL_COUNT} free web tools, no account needed. Every one of them runs live at
        <a href={APP_TOOLS_BASE} target="_blank" rel="noopener noreferrer" class="text-violet-400 hover:text-violet-300">app.laravelseo.com/tools</a>.
      </p>
    </div>

    {TOOL_CATEGORIES.map((category) => (
      <div class="mb-10 last:mb-0">
        <h3 class="text-lg font-semibold text-violet-300 mb-4">{category.name}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {category.tools.map((tool) => (
            <a
              href={`${APP_TOOLS_BASE}/${tool.slug}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 p-4 bg-slate-800/50 rounded-xl border border-slate-700/50 hover:border-violet-500/50 hover:bg-slate-800 transition-all group"
            >
              <div class="w-10 h-10 bg-violet-600/20 rounded-lg flex items-center justify-center flex-shrink-0 text-violet-400 group-hover:text-violet-300 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <div>
                <span class="text-white font-medium text-sm">{tool.name}</span>
                <p class="text-slate-400 text-xs mt-0.5">{tool.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="text-center mt-10">
      <a
        href="/tools"
        class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-violet-600 to-pink-500 hover:from-violet-500 hover:to-pink-400 rounded-lg transition-all shadow-lg shadow-violet-500/25"
      >
        Browse the full tools directory
      </a>
    </div>
  </div>
</section>
