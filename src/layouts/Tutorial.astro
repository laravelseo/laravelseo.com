---
import BaseLayout from "./BaseLayout.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  intro: string;
}

const { title, description, heading, intro } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <BreadcrumbSchema
    items={[
      { name: "Home", href: "/" },
      { name: "Tutorials", href: "/tutorials" },
      { name: heading, href: Astro.url.pathname },
    ]}
  />

  <section class="bg-slate-900 py-16 md:py-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-violet-400">Home</a>
        <span class="mx-2">/</span>
        <a href="/tutorials" class="hover:text-violet-400">Tutorials</a>
        <span class="mx-2">/</span>
        <span class="text-slate-300">{heading}</span>
      </nav>

      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{heading}</h1>
      <p class="text-slate-300 text-lg mb-10">{intro}</p>

      <div class="tutorial-body">
        <slot />
      </div>

      <div class="mt-14 p-6 bg-slate-800/60 rounded-xl border border-slate-700/50 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h2 class="text-white font-bold text-lg">Try it yourself</h2>
          <p class="text-slate-400 text-sm">Everything in this tutorial runs in the live app.</p>
        </div>
        <a
          href="https://app.laravelseo.com/login"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-violet-600 to-pink-500 hover:from-violet-500 hover:to-pink-400 rounded-lg transition-all shadow-lg shadow-violet-500/25 whitespace-nowrap"
        >
          Open app.laravelseo.com
        </a>
      </div>

      <p class="mt-8 text-sm text-slate-500">
        <a href="/tutorials" class="text-violet-400 hover:text-violet-300">&larr; Back to all tutorials</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .tutorial-body h2 {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    color: #fff;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .tutorial-body h3 {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 600;
    color: #fff;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .tutorial-body p {
    color: #cbd5e1;
    margin-bottom: 1rem;
    line-height: 1.625;
  }
  .tutorial-body ul,
  .tutorial-body ol {
    color: #cbd5e1;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .tutorial-body li {
    margin-bottom: 0.5rem;
  }
  .tutorial-body ul {
    list-style: disc;
  }
  .tutorial-body ol {
    list-style: decimal;
  }
  .tutorial-body a {
    color: #a78bfa;
  }
  .tutorial-body a:hover {
    color: #c4b5fd;
  }
  .tutorial-body strong {
    color: #fff;
  }
  .tutorial-body code {
    background-color: #1e293b;
    color: #c4b5fd;
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
  }
  .tutorial-body pre {
    background-color: #020617;
    border: 1px solid rgba(51, 65, 85, 0.6);
    border-radius: 0.75rem;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }
  .tutorial-body pre code {
    background: transparent;
    padding: 0;
    color: #e2e8f0;
  }
  .tutorial-body figure {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  .tutorial-body figcaption {
    color: #64748b;
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }
  .tutorial-body img {
    border-radius: 0.75rem;
    border: 1px solid #334155;
    width: 100%;
    height: auto;
  }
</style>
